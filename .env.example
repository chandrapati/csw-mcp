# ┌────────────────────────────────────────────────────────────┐
# │  csw-mcp — Environment Configuration                         │
# │                                                              │
# │  Copy this file to .env and fill in your cluster details:    │
# │    cp .env.example .env                                      │
# │                                                              │
# │  Generate API keys in the CSW UI:                            │
# │    User Menu → API Keys → Create API Key                     │
# │                                                              │
# │  Required capabilities (read-only use):                      │
# │    sensor_management, flow_inventory_query,                  │
# │    app_policy_management                                     │
# │                                                              │
# │  .env is git-ignored — never commit real credentials.        │
# └────────────────────────────────────────────────────────────┘

# Cluster base URL (no trailing slash, no path)
CSW_API_URL=https://demo-cluster.tetrationcloud.com

# API key (hex string from CSW UI)
CSW_API_KEY=your_api_key_here

# HMAC signing secret (paired with the API key)
CSW_API_SECRET=your_api_secret_here

# Set to "false" only if you hit CERTIFICATE_VERIFY_FAILED behind a
# corporate TLS proxy. Proper fix: trust your org root CA, or run Python's
# "Install Certificates.command". Default is "true".
# CSW_VERIFY_SSL=true
